# ==============================================================================
# Portfolio Environment Variables Template (.env.example)
# ==============================================================================
# انسخ هذا الملف إلى .env واملأ القيم المناسبة لبيئتك
# ==============================================================================

# 1. إعدادات التطبيق العامة
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_DEFAULT_THEME=system

# 2. قاعدة البيانات (MongoDB)
MONGODB_URI=mongodb://localhost:27017/portfolio
MONGODB_DB=portfolio

# 3. الأمان ولوحة تحكم المالك
AUTH_SECRET=your_super_secret_random_32_characters_string
AUTH_URL=http://localhost:3000
SESSION_MAX_AGE=86400
ADMIN_INITIAL_EMAIL=admin@portfolio.local
ADMIN_INITIAL_PASSWORD=ChangeThisPassword123!

# 4. خدمة إرسال الإيميلات وإشعارات الرسائل
EMAIL_PROVIDER=console
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=notifications@yourdomain.com
ADMIN_NOTIFICATION_EMAIL=owner@yourdomain.com

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# 5. مكتبة الوسائط ورفع الملفات
MEDIA_STORAGE_PROVIDER=local
UPLOAD_DIR=public/uploads

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_BUCKET_NAME=
S3_ENDPOINT=

# 6. الحماية ومكافحة السبام
HONEYPOT_FIELD_NAME=_hp_website_confirm
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# 7. نظام الإحصائيات الداخلي
ENABLE_ANALYTICS=true
